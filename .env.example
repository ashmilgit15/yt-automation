APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

POSTGRES_DB=video_factory
POSTGRES_USER=video_factory
POSTGRES_PASSWORD=replace-with-a-long-postgres-password
DATABASE_URL=postgresql+psycopg://video_factory:replace-with-a-long-postgres-password@postgres:5432/video_factory
REDIS_URL=redis://redis:6379/0
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

SESSION_SECRET=replace-with-a-long-random-session-secret
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=replace-with-a-strong-operator-password
MAX_REQUEST_BODY_BYTES=65536
DEFAULT_JOBS_PAGE_SIZE=24
LOCAL_ARTIFACTS_ROOT=backend/storage/jobs
GENERIC_BACKGROUND_MUSIC_PATH=backend/assets/background-music.mp3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
PEXELS_API_KEY=
QUALITY_GATE_THRESHOLD=7
KOKORO_VOICE=af_heart
KOKORO_LANGUAGE_CODE=a
EDGE_TTS_VOICE=en-US-EmmaMultilingualNeural
YOUTUBE_CLIENT_SECRETS_PATH=secrets/client_secrets.json
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_DEFAULT_CATEGORY_ID=27
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_LABEL=default
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
